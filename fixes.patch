+    let end = rest
+        .find(|c: char| c == '&' || c == '#')
+        .unwrap_or(rest.len());
+    let current = &rest[..end];
+    if current == "1" {
+        return None;
+    }
+    Some(format!("{}1{}", &url[..start], &rest[end..]))
